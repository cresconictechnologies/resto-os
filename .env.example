# ============================================================================
# RestoOS — Environment Configuration
# ============================================================================

# Application
APP_NAME=RestoOS
APP_ENV=production
DEBUG=False
PORT=8000

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Mode 1: Local SQLite (Default for offline desktop counter resilience)
# DATABASE_URL=sqlite:///server/restoos.db

# Mode 2: Supabase / Remote PostgreSQL (Cloud Sync & Multi-Branch Deployments)
# Copy your connection string from Supabase -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# Supabase API Credentials (Optional - for client SDK / Realtime features)
# ----------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# Thermal Hardware & Peripheral Integration
# ----------------------------------------------------------------------------
ESC_POS_PRINTER_IP=192.168.1.200
ESC_POS_PRINTER_PORT=9100
DRAWER_KICK_PULSE_HEX=1b700019fa
